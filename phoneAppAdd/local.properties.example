# 复制为 local.properties 后可覆盖 Debug 包的后端地址。
# USB 真机配合 adb reverse 使用 127.0.0.1；Android 模拟器改为 10.0.2.2。
ALICIA_API_BASE_URL=https://windwindwind-alicia.cn
ALICIA_RAG_BASE_URL=http://127.0.0.1:8081

# 默认保持 false。只有完成候选选择、最终确认、本地 allowlist 和后端鉴权验收后才可改为 true。
ALICIA_RAG_ACTION_EXECUTION_ENABLED=false

# 用户点击“确认计划”后，移动端发给 RAG 用于生成受控执行草稿的短语。
ALICIA_RAG_CONFIRMATION_MESSAGE=确认
