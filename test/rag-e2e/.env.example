# Copy this file to .env.local with prepare-local-env.ps1. Never commit .env.local.

# Dedicated Identity test account. It must have appRoles.rag=RAG_ADMIN and must
# not have global ADMIN or appRoles.cloud=CLOUD_ADMIN.
ALICIA_RAG_E2E_IDENTITY_BASE_URL=https://windwindwind-alicia.cn
ALICIA_RAG_E2E_TOKEN_ISSUER=https://windwindwind-alicia.cn
ALICIA_RAG_E2E_ACCOUNT=
ALICIA_RAG_E2E_PASSWORD=

# Use a separate DeepSeek key or a key approved for local evaluation.
DEEPSEEK_API_KEY=

# Generated by prepare-local-env.ps1. Do not reuse production secrets.
ALICIA_RAG_E2E_MYSQL_ROOT_PASSWORD=GENERATE_ME
ALICIA_RAG_E2E_EXEC_DB_PASSWORD=GENERATE_ME
ALICIA_RAG_E2E_REGISTRATION_SECRET=GENERATE_ME
ALICIA_RAG_E2E_CLOUD_SECRET=GENERATE_ME
ALICIA_RAG_E2E_SHARE_SECRET=GENERATE_ME

# Fixed isolated database names and loopback-only host ports.
ALICIA_RAG_E2E_CLOUD_DATABASE=alicia_cloud_storage_e2e
ALICIA_RAG_E2E_EXEC_DATABASE=alicia_rag_execution_e2e
ALICIA_RAG_E2E_EXEC_DB_USERNAME=alicia_rag_execution_e2e
ALICIA_RAG_E2E_DB_PORT=18310
ALICIA_RAG_E2E_API_PORT=18090
ALICIA_RAG_E2E_RAG_PORT=18091
ALICIA_RAG_E2E_EXEC_PORT=18094
ALICIA_RAG_E2E_CONFIRMATION_TTL=10m

# This is the second lock for the one safe local mutation scenario. Keep false
# for recognition-only runs; run-evaluation.ps1 also requires an explicit switch.
ALICIA_RAG_E2E_ALLOW_LOCAL_EXECUTION=false
